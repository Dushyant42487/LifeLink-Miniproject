# ==============================================================================
# LifeLink Healthcare Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env in production deployment:
#   cp .env.example .env
#
# IMPORTANT SECURITY GUIDANCE:
# - NEVER commit populated .env files to version control.
# - In production (NODE_ENV=production), startup validation requires:
#     1. A non-default JWT_SECRET of at least 32 characters.
#     2. A valid PORT.
#     3. Explicit CORS_ALLOWED_ORIGINS without open wildcards.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Runtime Environment
# ------------------------------------------------------------------------------
# Options: 'development' | 'test' | 'production'
NODE_ENV=production

# Network port for backend HTTP server (1-65535)
PORT=5001

# ------------------------------------------------------------------------------
# 2. Cryptographic & Session Secrets
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JSON Web Tokens (JWT).
# In production, must be at least 32 characters and cryptographically random:
# Example generation command: openssl rand -base64 36
JWT_SECRET=replace_with_min_32_char_cryptographically_secure_random_key_here

# ------------------------------------------------------------------------------
# 3. CORS & Network Security
# ------------------------------------------------------------------------------
# Gateway network port (default: 8090)
GATEWAY_PORT=8090

# Comma-separated list of fully-qualified origins permitted to make cross-origin requests.
# Do not use '*' in production.
# Example: http://localhost:8090,http://localhost:8080,https://lifelink.org
CORS_ALLOWED_ORIGINS=http://localhost:8090,http://localhost:8080,https://your-domain.example.com,https://portal.your-domain.example.com

# ------------------------------------------------------------------------------
# 4. Durable Storage & Database (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Provide valid credentials for durable relational persistence.
# If omitted or invalid, LifeLink operates on an in-memory DataStore (fallback mode),
# and records will NOT persist across server restarts.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=replace_with_supabase_service_role_secret_key
SUPABASE_ANON_KEY=replace_with_supabase_anon_public_key

# ------------------------------------------------------------------------------
# 5. Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# Base URL for API requests made from the browser.
# In standard deployment where frontend and API are reverse-proxied by Nginx/Caddy,
# leave as '/api'.
VITE_API_BASE_URL=/api

# ------------------------------------------------------------------------------
# 6. Logging & Telemetry
# ------------------------------------------------------------------------------
# Logging level: 'error' | 'warn' | 'info' | 'debug'
LOG_LEVEL=info
