{
  "name": "lifelink-backend",
  "version": "1.0.0",
  "description": "LifeLink Backend API - Intelligent Blood Donation & Inventory Management Platform",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/server.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "db:reset": "curl -s -X POST http://localhost:5001/api/test/reset",
    "db:seed:fixtures": "curl -s -X POST http://localhost:5001/api/test/seed-fixtures"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@types/mongoose": "^5.11.96",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.9.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
