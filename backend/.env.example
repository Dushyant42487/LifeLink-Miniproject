# ==============================================================================
# LifeLink Backend API — Environment Configuration Template
# ==============================================================================
NODE_ENV=production
PORT=5001

# Cryptographic signing secret (min 32 characters in production)
JWT_SECRET=replace_with_min_32_char_cryptographically_secure_random_key_here

# Allowed origins for CORS (comma-separated, no wildcards in production)
CORS_ALLOWED_ORIGINS=https://your-domain.example.com

# Supabase PostgreSQL durable persistence credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=replace_with_supabase_service_role_secret_key
SUPABASE_ANON_KEY=replace_with_supabase_anon_public_key

# Operational logging level
LOG_LEVEL=info
