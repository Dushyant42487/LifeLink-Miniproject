# Port this SMS microservice listens on
PORT=7001

# SMS Gateway for Android — Local Server mode (from the Android App's Local Server tab)
GATEWAY_HOST=192.168.1.100
GATEWAY_PORT=8080
GATEWAY_USER=sms
GATEWAY_PASS=your_gateway_password_here

# Set to true to simulate SMS delivery locally without a physical Android phone
SMS_MOCK_MODE=false
